# Firebase web client used by the Vue app and Playwright login tests
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin credentials used by the backend and seed script.
# Set exactly one of these. Never commit the credential JSON itself.
FIREBASE_CREDENTIALS_PATH=
# FIREBASE_CREDENTIALS_JSON=

# Optional service overrides (the listed values are the local defaults)
VITE_USER_SERVICE_URL=http://127.0.0.1:8001
VITE_EVENT_SERVICE_URL=http://127.0.0.1:8002
VITE_VENUE_SERVICE_URL=http://127.0.0.1:8003
VITE_EQUIPMENT_SERVICE_URL=http://127.0.0.1:8004
VITE_REGISTRATION_SERVICE_URL=http://127.0.0.1:8005
VITE_NOTIFICATION_SERVICE_URL=http://127.0.0.1:8006
